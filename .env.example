# "mock" (default) serves built-in sample data and accepts any login. Use "api" for the real backend.
DATA_SOURCE="mock"

# Server-side only. The admin console calls the Eventis API from the Next.js server
# (the API has no CORS), so this value is never sent to the browser.
API_BASE_URL="http://localhost:4000"

# Testing only (ignored when NODE_ENV=production): any phone/PIN typed on the login
# screen signs in as this admin. Leave unset elsewhere.
# TEST_LOGIN_BYPASS="true"
# TEST_ADMIN_PHONE="+250788000001"
# TEST_ADMIN_PIN="12345"
