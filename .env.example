# EVENTIS Admin Portal Environment Configuration

# Application Metadata
NEXT_PUBLIC_APP_NAME="EVENTIS Admin"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Companion Public Web App
NEXT_PUBLIC_WEB_APP_URL="http://localhost:3000"

# Backend API Configuration (REST / GraphQL)
NEXT_PUBLIC_API_BASE_URL="https://api.eventis.app/v1"
API_SECRET_KEY="your_admin_secret_api_key_here"

# Authentication & Session (NextAuth / JWT / Custom)
NEXTAUTH_SECRET="your_nextauth_jwt_secret_min_32_chars"
NEXTAUTH_URL="http://localhost:3001"

# Payment & Webhook Secrets (e.g. Stripe)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
